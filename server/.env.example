# RJ Tracker sync server — copy to .env (or export) and adjust.

# HTTP port and bind address
PORT=8787
HOST=0.0.0.0

# Where accounts are stored (one JSON document per account)
DATA_DIR=./server/data

# Keeps access tokens valid across restarts / container recreations.
# Generate with: openssl rand -base64 48
CLOUD_SECRET=

# Comma-separated browser origins allowed to call the API, or * for any.
CLOUD_ORIGINS=*

# Behind nginx / Caddy / Render: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=1

# Payload limits (bytes)
MAX_BODY_BYTES=12582912
MAX_ACCOUNT_BYTES=12582912
