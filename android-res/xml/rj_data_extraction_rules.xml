<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from this app is copied to Google Drive backups or to a new phone by device transfer.
     The WebView profile holds the sign-in session, AI provider keys and all study data; the app has its own
     encrypted-in-transit cloud sync and manual/automatic backup files for moving data safely. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
