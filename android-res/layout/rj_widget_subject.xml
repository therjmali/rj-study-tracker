                    android:textColor="#CAC4CF"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/rj_subj_bar4"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/rj_progress" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rj_subj_row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/rj_subj_badge5"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:background="@drawable/rj_widget_pill"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="SUBJ"
                android:textColor="#CBBEFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rj_subj_name5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Subject"
                        android:textColor="#E4E1E9"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rj_subj_pct5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="0%"
                        android:textColor="#4EDBD4"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rj_subj_meta5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="0 / 0 topics"
                    android:textColor="#CAC4CF"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/rj_subj_bar5"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/rj_progress" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/rj_subj_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open RJ Tracker once to load your subjects"
            android:textColor="#CAC4CF"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rj_subj_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:text="+1 more"
            android:textColor="#CBBEFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
