<?xml version="1.0" encoding="utf-8"?>
<!-- Compact timer notification: live time + the two actions you need, without expanding it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/rj_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/rj_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rj_time_paused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rj_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rj_btn_toggle"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/rj_bg_pill_outline"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rj_btn_stop"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/rj_bg_pill_danger"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
