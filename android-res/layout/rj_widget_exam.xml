<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rj_widget_exam_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rj_widget_bg"
    android:padding="12dp">

    <!-- Top Header: Icon + "EXAM COUNTDOWN" + Target Date -->
    <LinearLayout
        android:id="@+id/rj_widget_exam_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher_round"
            android:scaleType="centerInside"
            android:contentDescription="RJ Tracker" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="EXAM COUNTDOWN"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:singleLine="true" />

        <TextView
            android:id="@+id/rj_widget_exam_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rj_widget_pill"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Target Date"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Exam Title & Pace (Left) + Days Left Badge (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rj_widget_exam_header"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rj_widget_exam_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Semester Final Exams"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/rj_widget_exam_pace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⚡ Target: 3 topics / day"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/rj_widget_exam_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/rj_widget_pill_accent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="14 Days"
            android:textColor="#FB923C"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom subtext -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Tap to view exam schedule &amp; target pace 🎯"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:singleLine="true" />
</RelativeLayout>
